       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Source Message Control ID" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The MSH-10 (message control ID) of the most recent HL7 v2 SIU message applied to this\nAppointment. Provides traceability back to the interface engine's message log." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
