<http://example.org/fhir/siu2fhir-au/ImplementationGuide/example.fhir.siu2fhir.au> a fhir:ImplementationGuide ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example.fhir.siu2fhir.au"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide example.fhir.siu2fhir.au</b></p><a name=\"example.fhir.siu2fhir.au\"> </a><a name=\"hcexample.fhir.siu2fhir.au\"> </a><h2>SIU2FHIRAUCore</h2><p>The official URL for this implementation guide is: </p><pre>http://example.org/fhir/siu2fhir-au/ImplementationGuide/example.fhir.siu2fhir.au</pre><div><p>Describes how a proof-of-concept service converts HL7 v2 SIU S12, S13, S14 and S15 scheduling messages into FHIR R4 resources that conform to AU Core 2.0.0 (Patient, Practitioner, Location, Organization) plus an Appointment profile. Simulated data only; not for clinical use.</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "http://example.org/fhir/siu2fhir-au/ImplementationGuide/example.fhir.siu2fhir.au"] ;
  fhir:ImplementationGuide.version [ fhir:value "0.1.0"] ;
  fhir:ImplementationGuide.name [ fhir:value "SIU2FHIRAUCore"] ;
  fhir:ImplementationGuide.title [ fhir:value "HL7 v2 SIU to FHIR Appointment - AU Core (Proof of Concept)"] ;
  fhir:ImplementationGuide.status [ fhir:value "draft"] ;
  fhir:ImplementationGuide.experimental [ fhir:value "true"^^xsd:boolean] ;
  fhir:ImplementationGuide.date [ fhir:value "2026-10-30T02:04:31+00:00"^^xsd:dateTime] ;
  fhir:ImplementationGuide.publisher [ fhir:value "SIU2FHIR PoC"] ;
  fhir:ImplementationGuide.description [ fhir:value "Describes how a proof-of-concept service converts HL7 v2 SIU S12, S13, S14 and S15 scheduling messages into FHIR R4 resources that conform to AU Core 2.0.0 (Patient, Practitioner, Location, Organization) plus an Appointment profile. Simulated data only; not for clinical use."] ;
