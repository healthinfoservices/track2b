       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Source Message Date/Time" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The MSH-7 (date/time of message) of the most recent HL7 v2 SIU message applied to this\nAppointment. The ingestion service compares an incoming message's MSH-7 with this value\nand ignores messages that are older, so a delayed message cannot undo a later change." ] ;
